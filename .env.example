MYSQL_DATABASE=job_service
MYSQL_USER=job_user
MYSQL_PASSWORD=job_password
MYSQL_ROOT_PASSWORD=root_password

# HS512 cần khóa dài tối thiểu 64 byte. Hãy thay bằng chuỗi ngẫu nhiên khi triển khai thật.
JWT_ACCESS_KEY=replace-this-access-key-with-at-least-64-random-characters-1234567890
JWT_REFRESH_KEY=replace-this-refresh-key-with-at-least-64-random-characters-12345678

# Không bắt buộc. Chỉ cần khi dùng chức năng gợi ý qua Google Gemini.
GEMINI_API_KEY=

CORS_ALLOWED_ORIGINS=http://localhost:3000
